# The top level is a whitelist: anything new there (the ISO, hf-token.txt, a desync or mesh dump, an extracted
# disc folder) stays out of git until it is named here. A dump at the root went in twice (B92's `obj`, M101's desync json).
/*
!/.claude/
/.claude/worktrees/
!/.github/
!/crates/
!/docs/
!/fuzz/
!/plan/
!/research/
!/third_party/
!/tools/
!/web/
!/.gitattributes
!/.gitignore
!/AGENT.md
!/CLAUDE.md
!/CREDITS.md
!/Cargo.lock
!/Cargo.toml
!/deny.toml
!/LICENSE-APACHE
!/LICENSE-MIT
!/PLAN.md
!/README.md
!/RELEASE_NOTES.md
!/runner.toml
!/rust-toolchain.toml

# Retail data and anything derived from it never goes in git.
*.iso
replacements
context
target/
__pycache__/
# research/ holds our own scripts and notes only; captures and screenshots belong in context/
research/**/*.png
research/**/*.jpg
research/**/*.bin
research/**/*.p2s
research/**/*.p2m2
# journal entries are .md only
research/journal/**/*
!research/journal/**/
!research/journal/**/*.md
tools/upscale_mods.sh
research/tools/wasmtime-*/
/web/pkg/
/web/pkg-webgpu/
/web/version.txt
/web/build.txt
/web/shots/
/web/apple-touch-icon.png
/web/apple-touch-icon-precomposed.png
# M17 store listing cache and the player's Hugging Face token (written beside the game)
mods-store.json
